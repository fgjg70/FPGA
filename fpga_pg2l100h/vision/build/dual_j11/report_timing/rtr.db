    <table id="report_clock_network_slow" title="Clock Network" column_number="1" tree="">
        <column_headers/>
        <row>
            <data>clk50 (50.00MHZ) (drive 2285 loads) (min_rise, max_rise, min_fall, max_fall)</data>
            <row>
                <data file_id="../rtl/top_pg2l100h_vision.v" line_number="4">sys_clk (0.000, 0.000, 0.000, 0.000)</data>
                <row>
                    <data file_id="../rtl/top_pg2l100h_vision.v" line_number="4">sys_clk_ibuf/opit_0/I (0.096, 0.096, 0.096, 0.096)</data>
                    <row>
                        <data file_id="../rtl/top_pg2l100h_vision.v" line_number="4">sys_clk_ibuf/opit_0/O (1.050, 1.213, 0.955, 1.102)</data>
                        <row>
                            <data object_valid="true">sys_clk_ibuf/ntD (net)</data>
                            <row>
                                <data file_id="../rtl/top_pg2l100h_vision.v" line_number="4">sys_clk_ibuf/opit_1/DI (1.050, 1.213, 0.955, 1.102)</data>
                                <row>
                                    <data file_id="../rtl/top_pg2l100h_vision.v" line_number="4">sys_clk_ibuf/opit_1/DI_TO_CLK (1.141, 1.318, 1.046, 1.207)</data>
                                    <row>
                                        <data file_id="../rtl/top_pg2l100h_vision.v" line_number="4">nt_sys_clk (net)</data>
                                        <row>
                                            <data object_valid="true">HCKBROUTE_8/CLKIN (1.710, 1.998, 1.615, 1.887)</data>
                                            <row>
                                                <data object_valid="true">HCKBROUTE_8/CLKOUT (1.955, 2.285, 1.860, 2.174)</data>
                                                <row>
                                                    <data object_valid="true">ntR3321 (net)</data>
                                                    <row>
                                                        <data file_id="../rtl/vision_cpu_clock.v" line_number="20">cpu_clock_gen/pll/gpll_inst/CLKIN1 (2.402, 2.822, 2.308, 2.714)</data>
                                                        <row>
