    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name {clk50} [get_ports {sys_clk}] -period 20 -waveform {0 10}</data>
        </row>
        <row>
            <data>create_generated_clock -name {clk27} -source [get_ports {sys_clk}] -multiply_by 27 -divide_by 50 [get_pins {clock_gen/pll/CLKOUT0}]</data>
        </row>
        <row>
            <data>create_generated_clock -name {lcd_pixel} -source [get_pins {clock_gen/pll/CLKOUT0}] -divide_by 3 [get_ports {lcd_dclk}]</data>
        </row>
        <row>
            <data>create_generated_clock -name {camera_mclk} -source [get_ports {sys_clk}] -divide_by 4 [get_ports {cam_xclk}]</data>
        </row>
        <row>
            <data>create_generated_clock -name {cpu95} -source [get_ports {sys_clk}] -multiply_by 19 -divide_by 10 [get_pins {cpu_clock_gen/pll/CLKOUT0}]</data>
        </row>
        <row>
            <data>set_output_delay -clock [get_clocks {lcd_pixel}] -max 10 [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_hsync lcd_vsync lcd_de}]</data>
        </row>
        <row>
            <data>set_output_delay -clock [get_clocks {lcd_pixel}] -min 2 [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_hsync lcd_vsync lcd_de}]</data>
        </row>
        <row>
            <data>set_max_delay 20 -datapath_only -from [get_cells {video_bridge/held_payload[*]}] -to [get_cells {video_bridge/pending_payload[*]}]</data>
        </row>
        <row>
            <data>set_min_delay 0 -from [get_cells {video_bridge/held_payload[*]}] -to [get_cells {video_bridge/pending_payload[*]}]</data>
        </row>
        <row>
            <data>set_max_delay 20 -datapath_only -from [get_cells {system/cpu_bus/held_request[*]}] -to [get_cells {system/cpu_bus/active_request[*]}]</data>
        </row>
        <row>
            <data>set_min_delay 0 -from [get_cells {system/cpu_bus/held_request[*]}] -to [get_cells {system/cpu_bus/active_request[*]}]</data>
        </row>
        <row>
            <data>set_max_delay 10.5263 -datapath_only -from [get_cells {system/cpu_bus/held_response[*]}] -to [get_cells {system/cpu_bus/response_data[*]}]</data>
        </row>
        <row>
            <data>set_min_delay 0 -from [get_cells {system/cpu_bus/held_response[*]}] -to [get_cells {system/cpu_bus/response_data[*]}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {reset_n keys_n[*] uart_rxd cam_sda touch_busy}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {cam_pclk cam_href cam_vsync cam_data[*]}] -to [get_cells {capture/pclk_sync[0] capture/href_sync[0] capture/vsync_sync[0] capture/data_meta[*]}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_ports {led[*] uart_txd touch_sclk touch_cs_n touch_mosi cam_scl cam_sda cam_reset_n cam_pwdn}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_cells {video_bridge/request_meta video_bridge/acknowledge_meta video_bridge/frame_meta framebuffer/request_meta framebuffer/acknowledge_meta framebuffer/valid_meta}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_pins {video_reset_sync[*]/P framebuffer/reset_sync[*]/P}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_cells {system/cpu_bus/request_meta system/cpu_bus/response_meta}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_pins {cpu_reset_sync[*]/P}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_ports {servo_pwm[*]}]</data>
        </row>
    </table>
