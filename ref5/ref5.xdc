# ============================================================================
# ref5/ref5.xdc — ref5 参照核的时序约束 (与主核同口径)
#   一个时钟, 周期 20.000 ns; fmax = 1000 / (20 - WNS)
#   没有任何 IO 约束 (参照核只有 clk/rst + 两个观测输出, 不上板)
# ============================================================================
create_clock -period 20.000 -name clk [get_ports clk]
