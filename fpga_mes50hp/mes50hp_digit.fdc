create_clock -name {video_clk} [get_ports {video_clk}] -period {37.037037} -waveform {0 18.5185185}
create_generated_clock -name {hdmi_pixel} -source [get_ports {video_clk}] -divide_by 1 -invert [get_ports {hdmi_pclk}]
set_clock_groups -asynchronous -group [get_clocks {sys_clk_core}] -group [get_clocks {video_clk hdmi_pixel}]
set_output_delay -clock [get_clocks {hdmi_pixel}] -max 5 [get_ports {hdmi_data[*] hdmi_hsync hdmi_vsync hdmi_de}]
set_output_delay -clock [get_clocks {hdmi_pixel}] -min 1 [get_ports {hdmi_data[*] hdmi_hsync hdmi_vsync hdmi_de}]
set_false_path -from [get_ports {keys_n[*] sys_rst_n uart_rxd eeprom_scl eeprom_sda hdmi_scl hdmi_sda}]
set_false_path -to [get_ports {led[*] uart_txd hdmi_reset_n eeprom_scl eeprom_sda hdmi_scl hdmi_sda}]
