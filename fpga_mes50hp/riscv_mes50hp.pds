(_flow fab_demo "2022.2-SP1-Lite"
    (_comment "Generated by Fabric Compiler (version on 2022.2-SP1-Lite<build 132640>) at Sat Oct 31 17:01:12 2026")
    (_version "1.0.9")
    (_status "initial")
    (_project 
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "."))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos)
                    (_device PGL50H)
                    (_speedgrade -6)
                    (_package FBG484)
                )
            )
        )
        (_widget wgt_my_design_src
            (_input
                (_file "generated/riscv_pds.v" + "top_mes50hp:"
                    (_format verilog)
                    (_timespec "2026-10-24T19:06:35")
                )
            )
        )
        (_widget wgt_my_ips_src
        )
        (_widget wgt_import_logic_con_file
            (_input
                (_file "mes50hp.fdc"
                    (_format fdc)
                    (_timespec "2026-10-21T22:46:06")
                )
            )
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_simulation
        )
    )
    (_task tsk_compile
        (_command cmd_compile
            (_gci_state (_integer 2))
            (_option compiler_directives (_string "SYNTHESIS"))
            (_option loop_limit (_integer 10000))
            (_db_output
                (_file "compile/top_mes50hp_comp.adf"
                    (_format adif)
                    (_timespec "2026-10-31T16:58:30")
                )
            )
            (_output
                (_file "compile/top_mes50hp.cmr"
                    (_format verilog)
                    (_timespec "2026-10-31T16:58:30")
                )
                (_file "compile/cmr.db"
